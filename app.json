{
  "expo": {
    "name": "Browz",
    "slug": "myapp",
    "owner": "caique_007",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "jsEngine": "hermes",
    "notification": {
      "androidMode": "default"
    },
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "jsEngine": "hermes",
      "config": {
        "googleMapsApiKey": "AIzaSyBJg8pGeMaV4E1rUoj2rWMqp3K0OVw4fBw"
      }
    },
    "android": {
      "package": "com.caique_007.myapp",
      "googleServicesFile": "./google-services.json",
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false,
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBJg8pGeMaV4E1rUoj2rWMqp3K0OVw4fBw"
        }
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "O aplicativo precisa de acesso às suas fotos para anexar mídias ao chamado.",
          "cameraPermission": "O aplicativo precisa de acesso à câmera para tirar fotos e gravar vídeos dos chamados.",
          "microphonePermission": "O aplicativo precisa de acesso ao microfone para gravar vídeos dos chamados."
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "default",
          "sounds": [],
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "607e6908-5e0b-4396-b2e7-ccd4c6e3a42c"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    }
  }
}